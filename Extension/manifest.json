{
    "manifest_version": 3,
    "name": "PhishGuard",
    "version": "2.0",
    "description": "On-device phishing & scam detection for Indian vernacular languages. No data leaves your browser.",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "PhishGuard"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "model-data.js",
                "tier1.js",
                "heuristics.js",
                "redact.js",
                "detector.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}